{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aries",
  "version": "0.1.0",
  "identifier": "com.bytedance.aries.ui",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aries",
        "width": 1200,
        "height": 900,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
