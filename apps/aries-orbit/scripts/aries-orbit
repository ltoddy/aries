#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
    printf '%s\n' 'Usage: aries-orbit' >&2
    exit 2
fi

launcher=$0
while [ -L "$launcher" ]; do
    directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
    target=$(/usr/bin/readlink "$launcher")
    case "$target" in
        /*) launcher=$target ;;
        *) launcher=$directory/$target ;;
    esac
done

bundle=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
exec /usr/bin/open -a "$bundle"
